<odoo>
  <record id="view_order_form_approval" model="ir.ui.view">
    <field name="name">sale.order.form.approval</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

      <xpath expr="//header" position="inside">
        <button name="action_request_approval" type="object"
          string="Request Approval"
          invisible="not needs_approval or approval_state not in ('not_required', 'rejected')"
        />
        
        <button name="action_approve" type="object" string="Approve"
          groups="sale_approval.group_sale_approver"
          invisible="not needs_approval or approval_state != 'to_approve'"
        />

        <button name="action_reject" type="object" string="Reject"
          groups="sale_approval.group_sale_approver"
          invisible="not needs_approval or approval_state != 'to_approve'"
        />
      </xpath>

      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="approval_state" readonly="1"/>
      </xpath>

    </field>
  </record>
</odoo>